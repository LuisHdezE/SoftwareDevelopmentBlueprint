{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/proposals/agent-contract.schema.json",
  "title": "Blueprint Agent Contract Proposal",
  "description": "Proposal-stage machine-readable contract for one canonical Blueprint agent role. Presence does not imply stable release adoption.",
  "type": "object",
  "required": [
    "schema_version",
    "agent",
    "mission",
    "primary_question",
    "responsibilities",
    "inputs",
    "outputs",
    "permissions",
    "forbidden_actions",
    "completion_statuses"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-protocol-proposal-1"
    },
    "agent": {
      "$ref": "#/$defs/agent_id"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "primary_question": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "required": ["read", "write", "actions"],
      "properties": {
        "read": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role_status"
      }
    },
    "handoff_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/agent_id"
      }
    },
    "human_approval_required_for": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "merge",
          "release",
          "tag",
          "risk_acceptance",
          "scope_change",
          "requirement_decision"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "agent_id": {
      "enum": [
        "orchestrator",
        "analyst",
        "planner",
        "architect",
        "database",
        "backend",
        "frontend",
        "qa",
        "security",
        "documentation",
        "auditor"
      ]
    },
    "role_status": {
      "enum": [
        "ROUTED",
        "ANALYZED",
        "PLANNED",
        "ARCHITECTURE_READY",
        "DATA_READY",
        "BACKEND_IMPLEMENTED",
        "FRONTEND_IMPLEMENTED",
        "QA_PASS",
        "QA_FAIL",
        "SECURITY_PASS",
        "SECURITY_FAIL",
        "DOCUMENTED",
        "READY_FOR_MERGE",
        "READY_FOR_HUMAN_DECISION",
        "BLOCKED",
        "REJECTED"
      ]
    }
  },
  "additionalProperties": false
}
