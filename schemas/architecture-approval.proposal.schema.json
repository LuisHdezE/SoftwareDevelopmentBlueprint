{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.eliasworks.uy/proposals/architecture-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "protocol": {
      "const": "architecture-approval-proposal-1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "GREENFIELD",
            "BROWNFIELD",
            "EXTENSION"
          ]
        }
      },
      "required": [
        "repository",
        "owner",
        "mode"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "version": {
          "const": "proposal-1"
        }
      },
      "required": [
        "sha256",
        "source_commit",
        "version"
      ]
    },
    "decisions": {
      "type": "array",
      "minItems": 137,
      "maxItems": 137,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ARC-[0-9]{3}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "PENDING",
              "PROPOSED",
              "APPROVED",
              "REJECTED",
              "NOT_APPLICABLE",
              "REOPENED"
            ]
          },
          "applicability": {
            "enum": [
              "UNDETERMINED",
              "APPLICABLE",
              "NOT_APPLICABLE"
            ]
          },
          "selection": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "compatibility": {
            "enum": [
              "PENDING",
              "VERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "approval": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "authority": {
                    "const": "human_owner"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_id": {
                    "type": "string",
                    "pattern": "^ARC-[0-9]{3}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "catalog_sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "decision_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "authority",
                  "owner",
                  "decision_id",
                  "revision",
                  "catalog_sha",
                  "decision_digest",
                  "evidence",
                  "at"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "exception_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "revision",
          "status",
          "applicability",
          "selection",
          "rationale",
          "recommendation",
          "compatibility",
          "approval",
          "exception_id"
        ]
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "exception_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_id": {
            "enum": [
              "BF-P01",
              "BF-P02"
            ]
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "pattern": "^ARC-[0-9]{3}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigations": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "approval_evidence": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "affected_tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "EXPIRED"
            ]
          }
        },
        "required": [
          "exception_id",
          "policy_id",
          "project",
          "decision_id",
          "revision",
          "scope",
          "alternative",
          "rationale",
          "risk",
          "mitigations",
          "owner",
          "approval_evidence",
          "approved_at",
          "review_trigger",
          "expires_at",
          "affected_tests",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "project",
    "catalog",
    "decisions",
    "exceptions"
  ]
}
