{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/0.5.3-dev/ci-runtime.schema.json",
  "title": "Blueprint CI Runtime Contract",
  "type": "object",
  "required": ["schema_version", "orchestrator", "strategy", "runner", "security", "evidence", "maintenance"],
  "properties": {
    "schema_version": {"const": "0.5.3-dev"},
    "orchestrator": {"const": "github_actions"},
    "strategy": {"enum": ["github_hosted", "self_hosted", "hybrid"]},
    "runner": {
      "type": "object",
      "required": ["scope", "labels", "os", "arch", "persistent", "service_containers", "container_engine", "project_docker_capability_independent"],
      "properties": {
        "scope": {"enum": ["repository", "organization", "enterprise"]},
        "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "os": {"enum": ["linux", "windows", "macos"]},
        "arch": {"enum": ["x64", "arm64"]},
        "persistent": {"type": "boolean"},
        "service_containers": {"type": "boolean"},
        "container_engine": {"enum": ["docker", "none"]},
        "project_docker_capability_independent": {"const": true}
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "required": ["isolation", "lifecycle", "host_port_policy", "runtime_port_discovery", "shared_image_cache", "shared_runtime_instances", "healthcheck_required", "catalog"],
      "properties": {
        "isolation": {"const": "per_job"},
        "lifecycle": {"const": "ephemeral"},
        "host_port_policy": {"const": "dynamic"},
        "runtime_port_discovery": {"const": "github_actions_service_context"},
        "shared_image_cache": {"const": true},
        "shared_runtime_instances": {"const": false},
        "healthcheck_required": {"const": true},
        "catalog": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "mysql": {
              "allOf": [
                {"$ref": "#/$defs/serviceDefinition"},
                {"properties": {"container_port": {"const": 3306}}}
              ]
            },
            "postgresql": {
              "allOf": [
                {"$ref": "#/$defs/serviceDefinition"},
                {"properties": {"container_port": {"const": 5432}}}
              ]
            },
            "redis": {
              "allOf": [
                {"$ref": "#/$defs/serviceDefinition"},
                {"properties": {"container_port": {"const": 6379}}}
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["trusted_code_only", "fork_pull_requests", "persistent_secrets", "least_privilege_permissions"],
      "properties": {
        "trusted_code_only": {"type": "boolean"},
        "fork_pull_requests": {"enum": ["deny", "github_hosted_only"]},
        "persistent_secrets": {"const": false},
        "least_privilege_permissions": {"const": true}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["exact_head_required", "check_run_required", "pre_execution_infrastructure_failures_distinct_from_test_failures"],
      "properties": {
        "exact_head_required": {"const": true},
        "check_run_required": {"const": true},
        "pre_execution_infrastructure_failures_distinct_from_test_failures": {"const": true}
      },
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "required": ["workspace_cleanup", "runner_updates"],
      "properties": {
        "workspace_cleanup": {"const": true},
        "runner_updates": {"enum": ["automatic", "operator_managed"]}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "serviceDefinition": {
      "type": "object",
      "required": ["image", "container_port"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+$",
          "not": {"pattern": ":latest$"}
        },
        "container_port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"strategy": {"enum": ["self_hosted", "hybrid"]}}, "required": ["strategy"]},
      "then": {
        "properties": {
          "runner": {"properties": {"labels": {"allOf": [{"contains": {"const": "self-hosted"}}, {"contains": {"const": "blueprint"}}]}}},
          "security": {"properties": {"trusted_code_only": {"const": true}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runner": {"properties": {"service_containers": {"const": true}}, "required": ["service_containers"]}
        }
      },
      "then": {
        "required": ["services"],
        "properties": {
          "runner": {"properties": {"container_engine": {"const": "docker"}, "os": {"const": "linux"}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runner": {"properties": {"service_containers": {"const": false}}, "required": ["service_containers"]}
        }
      },
      "then": {"not": {"required": ["services"]}}
    }
  ],
  "additionalProperties": false
}
