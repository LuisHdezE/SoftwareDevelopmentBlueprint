{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/client-architecture.schema.json",
  "title": "Blueprint Client Architecture Contract",
  "type": "object",
  "required": [
    "schema_version",
    "architecture_id",
    "project_id",
    "mode",
    "interface_slice",
    "platform",
    "inventory_ids",
    "status",
    "visual_contract",
    "api_contract",
    "auth_lifecycle",
    "permissions",
    "routing",
    "state_management",
    "forms_validation",
    "async_states",
    "idempotency",
    "observability",
    "accessibility",
    "testing",
    "offline",
    "implementation_guardrails"
  ],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "architecture_id": {"type": "string", "pattern": "^CLIENT-(WEB|ANDROID)-[A-Z0-9][A-Z0-9._-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["greenfield", "brownfield"]},
    "interface_slice": {"type": "string", "minLength": 1},
    "platform": {"enum": ["web", "android"]},
    "inventory_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(WEB|APP)-[0-9]{3,}$"}
    },
    "status": {"enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED"]},
    "visual_contract": {
      "type": "object",
      "required": ["design_system_path", "tokens_path", "approved_reference_paths", "no_unapproved_interfaces"],
      "properties": {
        "design_system_path": {"type": "string", "minLength": 1},
        "tokens_path": {"type": "string", "minLength": 1},
        "approved_reference_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "no_unapproved_interfaces": {"const": true}
      },
      "additionalProperties": false
    },
    "api_contract": {
      "type": "object",
      "required": ["openapi_path", "operation_ids", "authorization_boundary", "error_contract", "request_id_header", "idempotency_header"],
      "properties": {
        "openapi_path": {"type": "string", "minLength": 1},
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorization_boundary": {"const": "api"},
        "error_contract": {"type": "string", "minLength": 1},
        "request_id_header": {"type": "string", "minLength": 1},
        "idempotency_header": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "auth_lifecycle": {
      "type": "object",
      "required": [
        "mechanism",
        "access_credential_storage",
        "refresh_credential_storage",
        "refresh_enabled",
        "refresh_rotation",
        "concurrent_refresh_policy",
        "unauthenticated_behavior",
        "forbidden_behavior",
        "logout_behavior",
        "secrets_must_not_be_logged"
      ],
      "properties": {
        "mechanism": {"enum": ["bearer_jwt", "session_cookie", "oauth2", "oidc", "custom"]},
        "access_credential_storage": {"enum": ["memory", "http_only_cookie", "platform_secure_storage", "not_applicable", "custom"]},
        "refresh_credential_storage": {"enum": ["memory", "http_only_cookie", "platform_secure_storage", "not_applicable", "custom"]},
        "refresh_enabled": {"type": "boolean"},
        "refresh_rotation": {"type": "boolean"},
        "concurrent_refresh_policy": {"enum": ["single_flight", "queue", "not_applicable", "custom"]},
        "unauthenticated_behavior": {"type": "string", "minLength": 1},
        "forbidden_behavior": {"type": "string", "minLength": 1},
        "logout_behavior": {"type": "string", "minLength": 1},
        "secrets_must_not_be_logged": {"const": true}
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["source", "ui_hides_or_disables_unauthorized_actions", "api_remains_authoritative"],
      "properties": {
        "source": {"const": "api_contract"},
        "ui_hides_or_disables_unauthorized_actions": {"type": "boolean"},
        "api_remains_authoritative": {"const": true}
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["strategy", "public_routes", "protected_routes", "permission_aware_navigation"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "public_routes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "protected_routes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "permission_aware_navigation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "state_management": {
      "type": "object",
      "required": ["server_state_strategy", "ui_state_strategy", "cache_strategy", "invalidation_rules"],
      "properties": {
        "server_state_strategy": {"type": "string", "minLength": 1},
        "ui_state_strategy": {"type": "string", "minLength": 1},
        "cache_strategy": {"type": "string", "minLength": 1},
        "invalidation_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "forms_validation": {
      "type": "object",
      "required": ["client_validation_strategy", "api_validation_mapping", "conflict_mapping", "rate_limit_mapping"],
      "properties": {
        "client_validation_strategy": {"type": "string", "minLength": 1},
        "api_validation_mapping": {"type": "string", "minLength": 1},
        "conflict_mapping": {"type": "string", "minLength": 1},
        "rate_limit_mapping": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "async_states": {
      "type": "object",
      "required": ["loading", "empty", "error", "401", "403", "404", "409", "422", "429", "offline"],
      "properties": {
        "loading": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "empty": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "error": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "401": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "403": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "404": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "409": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "422": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "429": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "offline": {"enum": ["REQUIRED", "NOT_APPLICABLE"]}
      },
      "additionalProperties": false
    },
    "idempotency": {
      "type": "object",
      "required": ["required_operations", "key_generation", "replay_handling", "conflict_handling"],
      "properties": {
        "required_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "key_generation": {"type": "string", "minLength": 1},
        "replay_handling": {"type": "string", "minLength": 1},
        "conflict_handling": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": ["request_id_header", "client_error_strategy", "secret_redaction", "pii_policy"],
      "properties": {
        "request_id_header": {"type": "string", "minLength": 1},
        "client_error_strategy": {"type": "string", "minLength": 1},
        "secret_redaction": {"const": true},
        "pii_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["target", "keyboard_or_switch_navigation", "screen_reader_or_talkback", "focus_management", "min_touch_target_px"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "keyboard_or_switch_navigation": {"type": "string", "minLength": 1},
        "screen_reader_or_talkback": {"type": "string", "minLength": 1},
        "focus_management": {"type": "string", "minLength": 1},
        "min_touch_target_px": {"type": "integer", "minimum": 44}
      },
      "additionalProperties": false
    },
    "testing": {
      "type": "object",
      "required": ["unit", "component_or_ui", "integration", "e2e"],
      "properties": {
        "unit": {"$ref": "#/$defs/testLayer"},
        "component_or_ui": {"$ref": "#/$defs/testLayer"},
        "integration": {"$ref": "#/$defs/testLayer"},
        "e2e": {"$ref": "#/$defs/testLayer"}
      },
      "additionalProperties": false
    },
    "offline": {
      "type": "object",
      "required": ["mode", "storage_strategy", "sync_conflict_policy"],
      "properties": {
        "mode": {"enum": ["unsupported", "degraded", "read_only", "queued_writes", "full_offline"]},
        "storage_strategy": {"type": "string", "minLength": 1},
        "sync_conflict_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "implementation_guardrails": {
      "type": "object",
      "required": ["no_new_api_behavior", "no_auth_bypass", "approved_inventory_only", "high_risk_mutations_follow_idempotency"],
      "properties": {
        "no_new_api_behavior": {"const": true},
        "no_auth_bypass": {"const": true},
        "approved_inventory_only": {"const": true},
        "high_risk_mutations_follow_idempotency": {"const": true}
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "required": ["framework", "rendering_mode", "router", "server_state_library", "form_library", "build_tool", "browser_support"],
      "properties": {
        "framework": {"const": "react"},
        "rendering_mode": {"enum": ["SPA", "SSR", "SSG", "HYBRID"]},
        "router": {"type": "string", "minLength": 1},
        "server_state_library": {"type": "string", "minLength": 1},
        "form_library": {"type": "string", "minLength": 1},
        "build_tool": {"type": "string", "minLength": 1},
        "browser_support": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "android": {
      "type": "object",
      "required": ["language", "ui_toolkit", "architecture_pattern", "networking_library", "local_persistence", "background_work", "min_sdk"],
      "properties": {
        "language": {"const": "kotlin"},
        "ui_toolkit": {"enum": ["jetpack_compose", "views", "hybrid"]},
        "architecture_pattern": {"type": "string", "minLength": 1},
        "networking_library": {"type": "string", "minLength": 1},
        "local_persistence": {"type": "string", "minLength": 1},
        "background_work": {"type": "string", "minLength": 1},
        "min_sdk": {"type": "integer", "minimum": 21}
      },
      "additionalProperties": false
    },
    "brownfield": {
      "type": "object",
      "required": ["coexistence_required", "existing_client_path", "migration_boundary", "cutover_trigger", "rollback_strategy", "remove_only_after_release_approval"],
      "properties": {
        "coexistence_required": {"const": true},
        "existing_client_path": {"type": "string", "minLength": 1},
        "migration_boundary": {"type": "string", "minLength": 1},
        "cutover_trigger": {"type": "string", "minLength": 1},
        "rollback_strategy": {"type": "string", "minLength": 1},
        "remove_only_after_release_approval": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "testLayer": {
      "type": "object",
      "required": ["required", "strategy"],
      "properties": {
        "required": {"type": "boolean"},
        "strategy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "web"}}},
      "then": {
        "required": ["web"],
        "properties": {"inventory_ids": {"items": {"type": "string", "pattern": "^WEB-[0-9]{3,}$"}}},
        "not": {"required": ["android"]}
      }
    },
    {
      "if": {"properties": {"platform": {"const": "android"}}},
      "then": {
        "required": ["android"],
        "properties": {"inventory_ids": {"items": {"type": "string", "pattern": "^APP-[0-9]{3,}$"}}},
        "not": {"required": ["web"]}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "brownfield"}}},
      "then": {"required": ["brownfield"]}
    }
  ],
  "additionalProperties": false
}
