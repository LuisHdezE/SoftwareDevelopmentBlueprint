{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/compliance-review.schema.json",
  "title": "Blueprint Consumer Compliance Review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "pilot_id",
    "repository",
    "mode",
    "baseline_blueprint",
    "target_blueprint",
    "reviewed_at",
    "reviewed_sources",
    "policy",
    "recommendation",
    "summary",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "pattern": "^CR-[A-Z0-9][A-Z0-9._-]*$"},
    "pilot_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "mode": {"enum": ["greenfield", "brownfield"]},
    "baseline_blueprint": {"type": "string", "minLength": 1},
    "target_blueprint": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["repository", "kind", "ref", "sha"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "kind": {"enum": ["blueprint", "consumer_main", "tracked_branch", "other"]},
          "ref": {"type": "string", "minLength": 1},
          "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": ["automatic_migration", "align_do_not_rewrite", "grandfather_existing_evidence", "consumer_mutated_by_review"],
      "properties": {
        "automatic_migration": {"const": false},
        "align_do_not_rewrite": {"const": true},
        "grandfather_existing_evidence": {"const": true},
        "consumer_mutated_by_review": {"const": false}
      },
      "additionalProperties": false
    },
    "recommendation": {"enum": ["ADOPT_INCREMENTALLY", "KEEP_BASELINE", "MIGRATE_NOW", "DEFER_ADOPTION", "REJECT"]},
    "summary": {
      "type": "object",
      "required": ["KEEP", "ADOPT", "MIGRATE", "DEFER", "N/A"],
      "properties": {
        "KEEP": {"type": "integer", "minimum": 0},
        "ADOPT": {"type": "integer", "minimum": 0},
        "MIGRATE": {"type": "integer", "minimum": 0},
        "DEFER": {"type": "integer", "minimum": 0},
        "N/A": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "v0_4_change", "classification", "rationale", "evidence", "action", "requires_consumer_change", "destructive_rewrite_allowed"],
        "properties": {
          "id": {"type": "string", "pattern": "^CRF-[0-9]{3}$"},
          "area": {"type": "string", "minLength": 1},
          "v0_4_change": {"type": "string", "minLength": 1},
          "classification": {"enum": ["KEEP", "ADOPT", "MIGRATE", "DEFER", "N/A"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "action": {"type": "string", "minLength": 1},
          "requires_consumer_change": {"type": "boolean"},
          "destructive_rewrite_allowed": {"const": false},
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
