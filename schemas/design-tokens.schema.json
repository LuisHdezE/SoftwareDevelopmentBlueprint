{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/design-tokens.schema.json",
  "title": "Blueprint Design Tokens",
  "type": "object",
  "required": ["schema_version", "colors", "typography", "spacing", "radius", "breakpoints", "accessibility"],
  "properties": {
    "schema_version": {"type": "string"},
    "colors": {
      "type": "object",
      "required": ["brand", "surface", "text", "semantic"],
      "properties": {
        "brand": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "surface": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "text": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "semantic": {
          "type": "object",
          "required": ["info", "success", "warning", "danger", "neutral"],
          "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      },
      "additionalProperties": true
    },
    "typography": {
      "type": "object",
      "required": ["heading", "body"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "scale": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}}
      },
      "additionalProperties": true
    },
    "spacing": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
    "radius": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
    "breakpoints": {
      "type": "object",
      "required": ["mobile_max", "tablet_min", "desktop_min"],
      "properties": {
        "mobile_max": {"type": "integer", "minimum": 320},
        "tablet_min": {"type": "integer", "minimum": 320},
        "desktop_min": {"type": "integer", "minimum": 768}
      },
      "additionalProperties": true
    },
    "accessibility": {
      "type": "object",
      "required": ["target", "minimum_touch_target_px"],
      "properties": {
        "target": {"const": "WCAG 2.2 AA"},
        "minimum_touch_target_px": {"type": "integer", "minimum": 44},
        "minimum_text_contrast_ratio": {"type": "number", "minimum": 4.5}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
