{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.local/schemas/evidence-record.schema.json",
  "title": "Blueprint Agent Evidence Record",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "task_id",
    "task_revision",
    "evidence_type",
    "producer_agent",
    "baseline",
    "result",
    "artifacts",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "agent-protocol-proposal-1"},
    "evidence_id": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"
    },
    "task_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "evidence_type": {
      "enum": [
        "IMPLEMENTATION_EVIDENCE",
        "QA_EVIDENCE",
        "SECURITY_EVIDENCE",
        "DOCUMENTATION_EVIDENCE",
        "SPECIALIST_EVIDENCE",
        "AUDIT_EVIDENCE"
      ]
    },
    "producer_agent": {
      "type": "string",
      "pattern": "^(orchestrator|analyst|planner|architect|database|backend|frontend|qa|security|documentation|auditor|specialist:[a-z][a-z0-9-]*)$"
    },
    "baseline": {
      "type": "object",
      "required": ["repository", "head_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "minLength": 7}
      },
      "additionalProperties": false
    },
    "result": {"enum": ["PASS", "FAIL", "INFORMATIONAL"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "revalidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["evidence_id", "from_revision"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"},
          "from_revision": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}