{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/project.schema.json",
  "title": "Blueprint Project Manifest",
  "type": "object",
  "required": ["project", "blueprint", "stack", "capabilities"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "repository"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "blueprint": {
      "type": "object",
      "required": ["version", "mode"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "mode": {"enum": ["greenfield", "brownfield"]}
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "backend": {"type": ["string", "null"]},
        "database": {"type": ["string", "null"]},
        "frontend": {"type": ["string", "null"]},
        "styling": {"type": ["string", "null"]},
        "mobile": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["web", "android", "saas", "docker"],
      "properties": {
        "web": {"type": "boolean"},
        "android": {"type": "boolean"},
        "saas": {"type": "boolean"},
        "multi_tenant": {"type": "boolean"},
        "offline_mobile": {"type": "boolean"},
        "redis": {"type": "boolean"},
        "docker": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "artifact_locations": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "evidence_root": {"type": "string", "minLength": 1},
        "interface_inventory": {"type": "string", "minLength": 1},
        "visual_identity": {"type": "string", "minLength": 1},
        "design_system": {"type": "string", "minLength": 1},
        "design_tokens": {"type": "string", "minLength": 1},
        "mockups_root": {"type": "string", "minLength": 1},
        "client_architecture_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
