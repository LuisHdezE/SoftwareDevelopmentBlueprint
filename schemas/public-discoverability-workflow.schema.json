{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/proposals/public-discoverability-workflow.schema.json",
  "title": "Blueprint Public Discoverability Workflow Overlay Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "capability",
    "specialist",
    "activation",
    "workflow",
    "phase_bindings",
    "gate",
    "provider_references",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "public-discoverability-workflow-proposal-1"
    },
    "capability": {
      "const": "public_discoverability"
    },
    "specialist": {
      "const": "specialist:search-ai-discoverability"
    },
    "activation": {
      "type": "object",
      "required": [
        "surface_class",
        "when_applicable",
        "when_not_applicable",
        "opt_out_when_applicable"
      ],
      "properties": {
        "surface_class": {
          "const": "PUBLIC_INDEXABLE"
        },
        "when_applicable": {
          "const": "REQUIRED"
        },
        "when_not_applicable": {
          "const": "NOT_APPLICABLE"
        },
        "opt_out_when_applicable": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "mode",
        "stable_sequence_mutated",
        "entry_after_gate",
        "sequence",
        "before_release_gate",
        "release_blocking_when_applicable"
      ],
      "properties": {
        "mode": {
          "const": "conditional_overlay"
        },
        "stable_sequence_mutated": {
          "const": false
        },
        "entry_after_gate": {
          "const": "interface_scope_ready"
        },
        "sequence": {
          "type": "array",
          "const": [
            "discoverability_surface_classification",
            "discoverability_contract",
            "discoverability_implementation",
            "discoverability_validation"
          ]
        },
        "before_release_gate": {
          "const": "discoverability_ready"
        },
        "release_blocking_when_applicable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "phase_bindings": {
      "type": "object",
      "required": [
        "discoverability_surface_classification",
        "discoverability_contract",
        "discoverability_implementation",
        "discoverability_validation"
      ],
      "properties": {
        "discoverability_surface_classification": {
          "$ref": "#/$defs/phase"
        },
        "discoverability_contract": {
          "$ref": "#/$defs/phase"
        },
        "discoverability_implementation": {
          "$ref": "#/$defs/phase"
        },
        "discoverability_validation": {
          "$ref": "#/$defs/phase"
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "id",
        "evaluation_scope",
        "required_role_evidence",
        "required_checks",
        "conditional_checks",
        "result_values",
        "stable_gate",
        "blocks_release_when_applicable"
      ],
      "properties": {
        "id": {
          "const": "discoverability_ready"
        },
        "evaluation_scope": {
          "const": "public_indexable_surface"
        },
        "required_role_evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role_evidence"
          }
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^discoverability\\.[a-z0-9_]+$"
          }
        },
        "conditional_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^discoverability\\.[a-z0-9_]+$"
          }
        },
        "result_values": {
          "type": "array",
          "const": [
            "READY_FOR_REVIEW",
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "stable_gate": {
          "const": false
        },
        "blocks_release_when_applicable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "provider_references": {
      "type": "object",
      "required": [
        "openai_crawlers",
        "openai_commerce",
        "google_product"
      ],
      "properties": {
        "openai_crawlers": {
          "type": "string",
          "format": "uri"
        },
        "openai_commerce": {
          "type": "string",
          "format": "uri"
        },
        "google_product": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "participant": {
      "oneOf": [
        {
          "enum": [
            "orchestrator",
            "analyst",
            "planner",
            "architect",
            "database",
            "backend",
            "frontend",
            "qa",
            "security",
            "documentation",
            "auditor"
          ]
        },
        {
          "type": "string",
          "pattern": "^specialist:[a-z][a-z0-9-]*$"
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/participant"
          }
        }
      },
      "additionalProperties": false
    },
    "role_evidence": {
      "type": "object",
      "required": [
        "participant",
        "status"
      ],
      "properties": {
        "participant": {
          "$ref": "#/$defs/participant"
        },
        "status": {
          "enum": [
            "SPECIALIST_PASS",
            "QA_PASS"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
