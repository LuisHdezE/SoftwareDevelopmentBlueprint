{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://eliasworks.dev/blueprint/0.5.0/reference-pilots.schema.json","title":"Blueprint Reference Pilot Registry","type":"object","required":["version","pilots"],"properties":{"version":{"const":"0.5.0"},"pilots":{"type":"array","items":{"type":"object","required":["id","repository","mode","role","normative","baseline_blueprint","status"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"mode":{"enum":["greenfield","brownfield"]},"role":{"const":"reference_pilot"},"normative":{"const":false},"baseline_blueprint":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"enum":["active","paused","completed","retired"]},"evidence_paths":{"type":"array","items":{"type":"string"}},"tracked_work":{"type":"array","items":{"type":"object","required":["kind","value"],"properties":{"kind":{"enum":["branch","pull_request","path","issue"]},"value":{"type":"string"},"note":{"type":"string"}},"additionalProperties":false}},"last_compliance_review":{"type":"object","required":["target_blueprint","artifact","report","recommendation","consumer_version_change"],"properties":{"target_blueprint":{"type":"string","minLength":1},"artifact":{"type":"string","minLength":1},"report":{"type":"string","minLength":1},"recommendation":{"enum":["ADOPT_INCREMENTALLY","KEEP_BASELINE","MIGRATE_NOW","DEFER_ADOPTION","REJECT"]},"consumer_version_change":{"enum":["APPLIED","DEFERRED","N/A"]},"reviewed_consumer_main":{"type":"string","pattern":"^[a-f0-9]{40}$"},"reviewed_tracked_branch":{"type":"string","pattern":"^[a-f0-9]{40}$"},"rule":{"type":"string"}},"additionalProperties":false},"notes":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}}},"additionalProperties":false}
