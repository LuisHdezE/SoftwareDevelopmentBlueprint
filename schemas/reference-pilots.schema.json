{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/reference-pilots.schema.json",
  "title": "Blueprint Reference Pilot Registry",
  "type": "object",
  "required": ["version", "pilots"],
  "properties": {
    "version": {"type": "string"},
    "pilots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "mode", "role", "normative", "baseline_blueprint", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "mode": {"enum": ["greenfield", "brownfield"]},
          "role": {"const": "reference_pilot"},
          "normative": {"const": false},
          "baseline_blueprint": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["active", "paused", "completed", "retired"]},
          "evidence_paths": {"type": "array", "items": {"type": "string"}},
          "tracked_work": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": {"enum": ["branch", "pull_request", "path", "issue"]},
                "value": {"type": "string"},
                "note": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
