{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/proposals/specialist-agent-registry.schema.json",
  "title": "Blueprint Conditional Specialist Registry Proposal",
  "type": "object",
  "required": ["schema_version", "specialists"],
  "properties": {
    "schema_version": {"const": "specialist-agent-registry-proposal-1"},
    "specialists": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "capability",
          "contract",
          "activation",
          "completion_statuses",
          "core_agent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^specialist:[a-z][a-z0-9-]*$"
          },
          "display_name": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "contract": {"type": "string", "pattern": "^agents/specialists/.+\\.md$"},
          "activation": {
            "type": "object",
            "required": ["mode", "condition"],
            "properties": {
              "mode": {"const": "conditional"},
              "condition": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "completion_statuses": {
            "type": "array",
            "const": ["SPECIALIST_PASS", "SPECIALIST_FAIL", "BLOCKED"]
          },
          "core_agent": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
