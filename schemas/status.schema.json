{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliasworks.dev/blueprint/status.schema.json",
  "title": "Blueprint Project Status",
  "type": "object",
  "required": ["blueprint_version", "updated_at", "phases", "checks", "gates"],
  "properties": {
    "blueprint_version": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "READY_FOR_REVIEW", "COMPLETE", "PASS", "FAIL", "BLOCKED", "N/A"]},
          "progress": {"type": "integer", "minimum": 0, "maximum": 100},
          "note": {"type": "string"}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "N/A"]},
          "verification": {"enum": ["manual", "automatic", "evidence", "file", "policy"]},
          "note": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "value"],
              "properties": {
                "id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"},
                "type": {"enum": ["file", "commit", "pull_request", "ci_run", "test_report", "postman_report", "openapi", "schema_validation", "design_system", "mockup_manifest", "visual_asset", "url", "manual_approval", "other"]},
                "value": {"type": "string"},
                "description": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PENDING", "READY_FOR_REVIEW", "PASS", "FAIL", "BLOCKED"]},
          "evaluated_at": {"type": ["string", "null"], "format": "date-time"},
          "note": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "value"],
              "properties": {
                "id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"},
                "type": {"enum": ["file", "commit", "pull_request", "ci_run", "test_report", "postman_report", "openapi", "schema_validation", "design_system", "mockup_manifest", "visual_asset", "url", "manual_approval", "other"]},
                "value": {"type": "string"},
                "description": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "interface_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "inventory_ids", "platforms", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "inventory_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(WEB|APP)-[0-9]{3}$"}, "uniqueItems": true},
          "platforms": {"type": "array", "minItems": 1, "items": {"enum": ["web", "android"]}, "uniqueItems": true},
          "status": {"enum": ["PLANNED", "IN_PROGRESS", "READY_FOR_REVIEW", "APPROVED", "BLOCKED", "COMPLETE"]},
          "mockup_batches": {"type": "array", "items": {"type": "string", "pattern": "^BATCH-[0-9]{2,}$"}, "uniqueItems": true},
          "approved_references": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "scoped_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "scope", "scope_id", "status"],
        "properties": {
          "gate": {"enum": ["visual_review_pass", "client_architecture_ready"]},
          "scope": {"enum": ["interface_slice", "interface_slice_platform"]},
          "scope_id": {"type": "string", "minLength": 1},
          "platform": {"enum": ["web", "android"]},
          "status": {"enum": ["PENDING", "READY_FOR_REVIEW", "PASS", "FAIL", "BLOCKED"]},
          "evaluated_at": {"type": ["string", "null"], "format": "date-time"},
          "note": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "value"],
              "properties": {
                "id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"},
                "type": {"enum": ["file", "commit", "pull_request", "ci_run", "test_report", "postman_report", "openapi", "schema_validation", "design_system", "mockup_manifest", "visual_asset", "url", "manual_approval", "other"]},
                "value": {"type": "string"},
                "description": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": true
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"scope": {"const": "interface_slice_platform"}}, "required": ["scope"]}, "then": {"required": ["platform"]}},
          {"if": {"properties": {"gate": {"const": "visual_review_pass"}}, "required": ["gate"]}, "then": {"properties": {"scope": {"const": "interface_slice"}}}},
          {"if": {"properties": {"gate": {"const": "client_architecture_ready"}}, "required": ["gate"]}, "then": {"properties": {"scope": {"const": "interface_slice_platform"}}}}
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9._-]*$"},
          "type": {"enum": ["file", "commit", "pull_request", "ci_run", "test_report", "postman_report", "openapi", "schema_validation", "design_system", "mockup_manifest", "visual_asset", "url", "manual_approval", "other"]},
          "value": {"type": "string"},
          "description": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
